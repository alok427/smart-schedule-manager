# ==============================================================================
# Smart Schedule Manager — Environment Configuration Example
# Copy this file to `.env` and fill in real values. Never commit the real `.env`.
# ==============================================================================

# --- Django core -------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (mandatory — do not use SQLite/MySQL) -------------------------
DB_NAME=smart_schedule_manager
DB_USER=ssm_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- CORS / CSRF ---------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- JWT -------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Email (optional, used for notifications) --------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@smartschedulemanager.local

# --- Static / Media -----------------------------------------------------------
STATIC_ROOT=staticfiles
MEDIA_ROOT=media
